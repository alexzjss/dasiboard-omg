# Copie para .env (nunca versione o .env). Valores abaixo são exemplos.

# --- Obrigatórias ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
SESSION_SECRET=
# 32+ caracteres; obrigatória em produção
INVITE_CODE_PEPPER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Opcionais ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=
PUBLIC_APP_URL=
VITE_PUBLIC_APP_URL=
# E-mails separados por vírgula com acesso de superadmin
SUPERADMIN_EMAILS=
# Web push (sem as três chaves o push fica desligado)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Só em desenvolvimento local. Proibido em produção.
DEV_FAKE_SESSION=
